<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200">
  <!-- Base clay color -->
  <rect width="200" height="200" fill="#B87333"/>
  
  <!-- Clay crack pattern -->
  <path fill="none" stroke="#8B4513" stroke-width="1" opacity="0.6" d="
    M20,0 L40,30 L30,60 L50,90 L40,120 L20,150 L30,200
    M80,0 L100,40 L90,80 L110,120 L90,160 L100,200
    M140,0 L160,50 L150,100 L170,150 L160,200
    M0,40 L200,60
    M0,100 L200,110
    M0,160 L200,170
  "/>
  
  <!-- Clay texture elements -->
  <g fill="#A0522D" opacity="0.3">
    <circle cx="30" cy="40" r="2"/>
    <circle cx="70" cy="60" r="3"/>
    <circle cx="110" cy="30" r="2"/>
    <circle cx="150" cy="50" r="3"/>
    <circle cx="190" cy="40" r="2"/>
    <circle cx="40" cy="100" r="3"/>
    <circle cx="80" cy="120" r="2"/>
    <circle cx="120" cy="90" r="3"/>
    <circle cx="160" cy="110" r="2"/>
    <circle cx="50" cy="160" r="3"/>
    <circle cx="90" cy="180" r="2"/>
    <circle cx="130" cy="150" r="3"/>
    <circle cx="170" cy="170" r="2"/>
  </g>
</svg>
