<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200">
  <!-- Base soil color -->
  <rect width="200" height="200" fill="#8B4513"/>
  
  <!-- Soil texture elements -->
  <g fill="#654321" opacity="0.7">
    <!-- Random soil particles -->
    <circle cx="20" cy="30" r="4"/>
    <circle cx="50" cy="60" r="3"/>
    <circle cx="80" cy="40" r="5"/>
    <circle cx="120" cy="70" r="4"/>
    <circle cx="160" cy="50" r="3"/>
    <circle cx="30" cy="100" r="4"/>
    <circle cx="70" cy="130" r="5"/>
    <circle cx="110" cy="150" r="3"/>
    <circle cx="150" cy="120" r="4"/>
    <circle cx="180" cy="170" r="5"/>
  </g>
  
  <!-- Lighter soil particles -->
  <g fill="#A0522D" opacity="0.5">
    <circle cx="40" cy="20" r="3"/>
    <circle cx="90" cy="50" r="2"/>
    <circle cx="130" cy="30" r="4"/>
    <circle cx="170" cy="60" r="3"/>
    <circle cx="25" cy="80" r="2"/>
    <circle cx="60" cy="110" r="3"/>
    <circle cx="100" cy="140" r="2"/>
    <circle cx="140" cy="170" r="3"/>
    <circle cx="175" cy="130" r="2"/>
  </g>
</svg>
