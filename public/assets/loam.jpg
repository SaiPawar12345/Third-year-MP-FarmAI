<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200">
  <!-- Base loam color -->
  <rect width="200" height="200" fill="#966F33"/>
  
  <!-- Organic matter particles -->
  <g fill="#654321" opacity="0.4">
    <path d="M40,30 L45,35 L42,40 L37,38 Z"/>
    <path d="M90,50 L95,53 L93,58 L87,56 Z"/>
    <path d="M140,40 L145,45 L142,50 L137,47 Z"/>
    <path d="M60,80 L65,85 L62,90 L57,87 Z"/>
    <path d="M110,100 L115,105 L112,110 L107,107 Z"/>
    <path d="M160,90 L165,95 L162,100 L157,97 Z"/>
    <path d="M30,130 L35,135 L32,140 L27,137 Z"/>
    <path d="M80,150 L85,155 L82,160 L77,157 Z"/>
    <path d="M130,140 L135,145 L132,150 L127,147 Z"/>
  </g>
  
  <!-- Sand particles -->
  <g fill="#DEB887" opacity="0.3">
    <circle cx="20" cy="20" r="2"/>
    <circle cx="50" cy="40" r="1"/>
    <circle cx="80" cy="30" r="2"/>
    <circle cx="120" cy="50" r="1"/>
    <circle cx="160" cy="40" r="2"/>
    <circle cx="40" cy="80" r="1"/>
    <circle cx="70" cy="100" r="2"/>
    <circle cx="110" cy="90" r="1"/>
    <circle cx="150" cy="110" r="2"/>
    <circle cx="30" cy="140" r="1"/>
    <circle cx="60" cy="160" r="2"/>
    <circle cx="100" cy="150" r="1"/>
    <circle cx="140" cy="170" r="2"/>
  </g>
  
  <!-- Silt particles -->
  <g fill="#A0522D" opacity="0.2">
    <rect x="25" y="45" width="2" height="2"/>
    <rect x="55" y="65" width="2" height="2"/>
    <rect x="85" y="55" width="2" height="2"/>
    <rect x="125" y="75" width="2" height="2"/>
    <rect x="165" y="65" width="2" height="2"/>
    <rect x="45" y="105" width="2" height="2"/>
    <rect x="75" y="125" width="2" height="2"/>
    <rect x="115" y="115" width="2" height="2"/>
    <rect x="155" y="135" width="2" height="2"/>
    <rect x="35" y="165" width="2" height="2"/>
    <rect x="65" y="185" width="2" height="2"/>
    <rect x="105" y="175" width="2" height="2"/>
    <rect x="145" y="195" width="2" height="2"/>
  </g>
</svg>
